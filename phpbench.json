{
    "$schema":"./vendor/phpbench/phpbench/phpbench.schema.json",
    "runner.bootstrap": "tests/bootstrap.php",
    "runner.path": "tests/Benchmark",
    "runner.executor": "perfidious-linux",
    "runner.progress": "perfidious-linux",
    "core.profiles": {
        "perfidious-linux-remote": {
            "runner.executor": "perfidious-linux-remote"
        },
        "perfidious-linux-remote-ci": {
            "runner.executor": "perfidious-linux-remote",
            "perfidious.linux.metrics": [
                "perf::PERF_COUNT_SW_CPU_CLOCK"
            ]
        }
    },
    "core.extensions": [
        "jbboehr\\PhpBenchPerfidious\\PerfidiousExtension"
    ],
    "report.generators": {
        "all": {
            "generator": "composite",
            "reports": [ "default", "perfidious", "aggregate", "env" ]
        },
        "perfidious": {
            "generator": "perfidious"
        }
    },
    "perfidious.linux.metrics": [
        "perf::PERF_COUNT_SW_CPU_CLOCK",
        "perf::PERF_COUNT_HW_INSTRUCTIONS",
        "perf::PERF_COUNT_SW_PAGE_FAULTS",
        "perf::PERF_COUNT_SW_CONTEXT_SWITCHES"
    ]
}
